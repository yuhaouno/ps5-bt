+/* Isolated reference: authenticate every network resource before routing.
+ * The private generated header is deliberately absent from the reusable patch.
+ */
+static int reference_reply(char *out, int max, int code)
+{
+    int n = snprintf(out, (size_t)max,
+        "HTTP/1.1 %d %s\r\n%sContent-Length: 0\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n",
+        code, code == 401 ? "Unauthorized" : code == 403 ? "Forbidden" : "Not Found",
+        code == 401 ? "WWW-Authenticate: Basic realm=\"PS5-BT reference\"\r\n" : "");
+    return n > 0 && n < max ? n : 0;
+}
+static int reference_origin(const char *value, const char *host)
+{
+    size_t n = strlen(host);
+    return !strncmp(value, "http://", 7) && !strncmp(value + 7, host, n) &&
+           (!value[7 + n] || value[7 + n] == '/');
+}
+int http_reference_gate(const char *req, int reqlen, char *out, int max)
+{
+    char auth[256], host[128], origin[256], method[8], path[128];
+    static const char *const reads[] = {"/", "/index.html", "/font.woff2", "/api/status", "/api/devices", "/api/saved", "/api/diag", "/api/blocked"};
+    static const char *const writes[] = {"/api/select", "/api/forget", "/api/scan", "/api/reconnect", "/api/connect", "/api/disconnect", "/api/volume", "/api/mute", "/api/tone", "/api/stop"};
+    int i = 0, j = 0, allowed = 0;
+    size_t k;
+    if (!header_value(req, reqlen, "Authorization", auth, sizeof auth) ||
+        !token_ok(auth, HB_REF_BASIC_AUTH)) return reference_reply(out, max, 401);
+    while (i < reqlen && req[i] != ' ' && j < (int)sizeof method - 1) method[j++] = req[i++];
+    method[j] = 0;
+    if (i >= reqlen || req[i++] != ' ') return reference_reply(out, max, 403);
+    j = 0;
+    while (i < reqlen && req[i] != ' ' && req[i] != '?' && j < (int)sizeof path - 1) path[j++] = req[i++];
+    path[j] = 0;
+    if (!strcmp(method, "GET")) {
+        for (k = 0; k < sizeof reads / sizeof reads[0]; k++) if (!strcmp(path, reads[k])) allowed = 1;
+    } else if (!strcmp(method, "POST")) {
+        for (k = 0; k < sizeof writes / sizeof writes[0]; k++) if (!strcmp(path, writes[k])) allowed = 1;
+        if (!header_value(req, reqlen, "Host", host, sizeof host) || !host[0]) return reference_reply(out, max, 403);
+        if (header_value(req, reqlen, "Origin", origin, sizeof origin) && !reference_origin(origin, host)) return reference_reply(out, max, 403);
+        if (header_value(req, reqlen, "Referer", origin, sizeof origin) && !reference_origin(origin, host)) return reference_reply(out, max, 403);
+    }
+    return allowed ? 0 : reference_reply(out, max, 404);
+}
