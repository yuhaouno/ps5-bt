diff --git a/tests/test_reference_stop.c b/tests/test_reference_stop.c
new file mode 100644
index 0000000..6d70ead
--- /dev/null
+++ b/tests/test_reference_stop.c
@@ -0,0 +1,55 @@
+/* Bounded reference stop policy with synthetic time/files/signals only. */
+#define _POSIX_C_SOURCE 200809L
+#include <assert.h>
+#include <signal.h>
+#include <time.h>
+#include <unistd.h>
+static long tick;
+static int clock_fail;
+static int reference_clock_gettime(clockid_t c, struct timespec *t)
+{
+    (void)c;
+    if (clock_fail) return -1;
+    t->tv_sec = tick / 1000;
+    t->tv_nsec = (tick % 1000) * 1000000;
+    return 0;
+}
+#define clock_gettime reference_clock_gettime
+#include "../src/util.c"
+#undef clock_gettime
+static int reference_access(const char *p, int mode) { (void)p; (void)mode; return -1; }
+static int reference_unlink(const char *p) { (void)p; return 0; }
+static void (*reference_signal(int s, void (*fn)(int)))(int) { (void)s; return fn; }
+#define access reference_access
+#define unlink reference_unlink
+#define signal reference_signal
+#include "../src/stop.c"
+#undef access
+#undef unlink
+#undef signal
+void log_line(const char *fmt, ...) { (void)fmt; }
+int main(void)
+{
+    tick = 1000;
+    hb_stop_init();
+    assert(!hb_stop_requested());
+    tick = 180999;
+    assert(!hb_stop_requested());
+    tick = 181000;
+    assert(hb_stop_requested());
+    tick = 1000;
+    hb_stop_init();
+    tick = 10000;
+    assert(!hb_stop_requested());
+    tick = 9000; /* Rollback still above the start must stop. */
+    assert(hb_stop_requested());
+    tick = 1000;
+    hb_stop_init();
+    hb_stop_request();
+    assert(hb_stop_requested());
+    clock_fail = 1;
+    assert(now_ms() == -1);
+    hb_stop_init();
+    assert(hb_stop_requested());
+    return 0;
+}
