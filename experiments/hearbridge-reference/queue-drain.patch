+/* Advisory cap changes never alter queued PDUs or transport credits. */
+static void media_cap_step(btlink *l, long now)
+{
+    ps5bt_queue_drain_result r;
+    int old;
+    if (l->media_requested_cap <= 0) return;
+    old = btlink_media_cap(l);
+    r = ps5bt_queue_drain_step(&l->media_drain, now, (unsigned)old,
+                              (unsigned)l->media_requested_cap, (unsigned)l->txq_media);
+    l->media_cap = (int)r.cap;
+    if (r.reason != PS5BT_DRAIN_KEEP || old != l->media_cap)
+        log_line("ps5-bt drain: reason=%d cap=%d->%d target=%d media=%d waited=%ld ms max=%d ms",
+                 (int)r.reason, old, l->media_cap, l->media_requested_cap,
+                 l->txq_media, (long)r.waited_ms, PS5BT_QUEUE_DRAIN_MAX_MS);
+}
